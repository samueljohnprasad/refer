{
  "expo": {
    "name": "Happy",
    "slug": "happy",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon-panda.png",
    "scheme": "happy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "appleTeamId": "QG7UY38762",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.samuelprasad.happy",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.samuelprasad.happy"
        ]
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "The app needs access to the microphone to record your voice for journal entries. For example, this allows you to speak your thoughts and save them as audio reflections in your daily journal.",
        "NSPhotoLibraryUsageDescription": "Happy needs access to your photos to upload handwritten journal notes and attach photos to your reflections.",
        "NSCameraUsageDescription": "Happy needs access to the camera to take photos of your handwritten journal pages to convert them into reflections.",
        "NSUserNotificationUsageDescription": "The app sends notifications to remind you to record your daily voice journal entries.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [],
        "EXDevMenuShowFloatingActionButton": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/icon-panda.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.samuelprasad.happy",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "$(PRODUCT_NAME) needs access to the microphone to record your voice for journal entries. For example, this allows you to speak your thoughts and save them as audio reflections in your daily journal."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/icons/icon-panda.png",
          "dark": {
            "image": "./assets/icons/icon-panda.png",
            "backgroundColor": "#ffffff"
          },
          "imageWidth": 100
        }
      ],
      "expo-asset",
      "expo-apple-authentication",
      "@bacons/apple-targets",
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-status-bar",
      [
        "llama.rn",
        {
          "enableEntitlements": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b87a1855-bf48-4992-9004-1ec817a4a5de",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.samuelprasad.happy.widget",
                  "targetName": "widget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.samuelprasad.happy"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b87a1855-bf48-4992-9004-1ec817a4a5de"
    }
  }
}

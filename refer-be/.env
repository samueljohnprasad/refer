# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/refer-net

# JWT Secret
JWT_SECRET=refer_net_development_secret_key
JWT_EXPIRES_IN=7d

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-app-specific-password  # Use App Password, not your Gmail password
EMAIL_FROM="ReferNet" <your-gmail@gmail.com>
